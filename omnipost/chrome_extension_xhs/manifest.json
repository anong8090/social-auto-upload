{
  "manifest_version": 3,
  "name": "河狸云个人IP · 浏览器填入",
  "version": "1.1.0",
  "description": "读取本机桥接的当日个人IP内容，填入小红书或今日头条发布页；不点击发布。",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://creator.xiaohongshu.com/*",
    "https://mp.toutiao.com/*",
    "http://127.0.0.1:5419/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "填入今日内容"
  },
  "content_scripts": [
    {
      "matches": ["https://creator.xiaohongshu.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mp.toutiao.com/*"],
      "js": ["content-toutiao.js"],
      "run_at": "document_idle"
    }
  ]
}
